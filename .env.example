; Copy to .env and adjust. .env is git-ignored; this file is the committed template.
; Quote any value containing # ; = or spaces:  DB_PASS="p@ss#word"

APP_NAME    = "Nova DS"
APP_VERSION = "1.0"
APP_DEBUG   = true
APP_LOCALE  = "ka"

; Read by App\Core\Auth. Every request (any logged-in user, independently —
; sessions are per-browser/per-user, never shared) that goes SESSION_TIMEOUT_MINUTES
; without one refreshes Auth::check()'s activity stamp; the next request past
; that gets logged out and redirected to /login by the app-wide gate in
; public/index.php. Separate from Auth::login()'s "remember me" cookie, which
; only controls whether the browser still has the session cookie next time it
; opens — this controls how long an *open* session may sit idle.
SESSION_TIMEOUT_MINUTES = 30

; Read by App\Core\Db. On OSPanel use the module name, e.g. DB_HOST = "MySQL-8.4".
DB_HOST = "localhost"
DB_NAME = "invoice"
DB_USER = "root"
DB_PASS = ""

; Read by App\Core\Mailer (raw SMTP, no library) — used for OTP login codes and
; password-reset links. MAIL_ENCRYPTION is "tls" (STARTTLS, usually port 587),
; "ssl" (implicit TLS, usually port 465) or "none".
MAIL_HOST = ""
MAIL_PORT = 587
MAIL_USERNAME = ""
MAIL_PASSWORD = ""
MAIL_ENCRYPTION = "tls"
MAIL_FROM = ""
MAIL_FROM_NAME = "Nova DS"

; Read by App\Core\GoogleOAuth ("Continue with Google" on /login and /register).
; Create these in Google Cloud Console > APIs & Services > Credentials > OAuth
; client ID (Web application). Authorized redirect URI must be exactly
; https://<your-domain>/auth/google/callback.
GOOGLE_CLIENT_ID = ""
GOOGLE_CLIENT_SECRET = ""

; Read by App\Core\Sms (smsoffice.ge) — the SMS channel for one-time login codes.
SMS_API_KEY = ""
SMS_SENDER = ""

; Read by App\Core\Pixabay — rotating "finance" photos on the auth pages'
; left panel. Get a free key at pixabay.com/api/docs/ (no app review). Free
; tier is 100 requests/minute, comfortable for the panel's 10-15s polling.
; Without a key the panel just shows the brand gradient with no photo.
PIXABAY_API_KEY = ""
